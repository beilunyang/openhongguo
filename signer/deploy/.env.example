# Image to run. The release workflow pushes <user>/openhongguo-signer:<tag>
# and :latest to Docker Hub. Leave it unset to build locally with --build.
SIGNER_IMAGE=
# Domain whose A record points at this server; caddy serves HTTPS for it.
SIGNER_DOMAIN=signer.example.com
# Callers send "Authorization: Bearer <token>". Empty means no auth.
# Generate with: openssl rand -hex 32
SIGNER_TOKEN=
# Host address for the signer's own port. 127.0.0.1: only this server.
SIGNER_BIND=127.0.0.1
SIGNER_PUBLISH_PORT=19830
